{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "server/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)",    "dest": "server/index.js" },
    { "src": "/images/(.*)", "dest": "server/index.js" },
    { "src": "/(.*)",        "dest": "server/index.js" }
  ]
}
